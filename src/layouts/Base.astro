---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "JavadED" } = Astro.props;
---

<!DOCTYPE html>
<html class="dark">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <script defer is:inline src="https://cloud.umami.is/script.js" data-website-id="01a8c312-f621-4687-aa20-4fd5f49582db"></script>

    <link rel="alternate" type="application/rss+xml" title="JavadED" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-bg-light text-ink-light font-display antialiased">
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
      <div class="layout-container mx-auto flex w-full max-w-4xl grow flex-col px-6 sm:px-8">
        <Navbar />

        <main class="flex flex-1 flex-col">
          <slot />
        </main>

        <Footer />
      </div>
    </div>
  </body>
</html>
