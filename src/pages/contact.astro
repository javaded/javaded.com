---
import Base from "../layouts/Base.astro";

const apiBase = import.meta.env.PUBLIC_API_URL ?? "";
---

<Base title="Get in Touch · JavadED">
  <section class="flex flex-col items-center text-center pb-16 pt-4 sm:pt-8">
    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight">Get in Touch</h1>
    <p class="mt-4 max-w-xl text-base sm:text-lg leading-relaxed text-subtle-light">
      Got an idea, collaboration, or question? I'd love to hear from you.
    </p>

    <form
      data-api={apiBase}
      class="js-contact mt-12 w-full max-w-xl space-y-6 text-left"
      novalidate
    >
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="flex flex-col">
        <label for="name" class="pb-2 text-sm font-medium">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Your Name"
          class="flex w-full rounded-lg border bg-transparent px-4 py-3 text-base font-normal leading-normal transition-colors placeholder:text-subtle-light border-edge-light focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        />
      </div>

      <div class="flex flex-col">
        <label for="email" class="pb-2 text-sm font-medium">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="your.email@example.com"
          class="flex w-full rounded-lg border bg-transparent px-4 py-3 text-base font-normal leading-normal transition-colors placeholder:text-subtle-light border-edge-light focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        />
      </div>

      <div class="flex flex-col">
        <label for="message" class="pb-2 text-sm font-medium">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Tell me about your idea..."
          class="flex w-full resize-y rounded-lg border bg-transparent px-4 py-3 text-base font-normal leading-normal transition-colors placeholder:text-subtle-light border-edge-light focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        ></textarea>
      </div>

      <button
        type="submit"
        class="js-contact-btn w-full rounded-lg bg-ink-light text-bg-light px-6 py-3 text-base font-semibold transition-opacity hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-bg-light cursor-pointer disabled:opacity-50"
      >Send Message</button>

      <p class="js-contact-status text-sm text-center text-subtle-light" role="status" aria-live="polite"></p>
    </form>

    <div class="mt-16 text-center">
      <p class="text-sm text-subtle-light">Or reach out via</p>
      <div class="mt-4 flex items-center justify-center gap-6">
        <a href="https://x.com/javaded" target="_blank" rel="noopener" class="font-medium hover:text-primary transition-colors">X / Twitter</a>
        <a href="https://www.youtube.com/@Javaded" target="_blank" rel="noopener" class="font-medium hover:text-primary transition-colors">YouTube</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>(".js-contact");
  const status = document.querySelector<HTMLElement>(".js-contact-status");
  const button = document.querySelector<HTMLButtonElement>(".js-contact-btn");

  function setStatus(message: string, ok: boolean) {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle("text-red-400", !ok);
    status.classList.toggle("text-subtle-light", ok);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const api = form.dataset.api?.replace(/\/$/, "");
    const name = (form.elements.namedItem("name") as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem("message") as HTMLTextAreaElement).value.trim();
    const website = (form.elements.namedItem("website") as HTMLInputElement).value;

    if (!api) {
      setStatus("The contact form is not configured yet.", false);
      return;
    }
    if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !message) {
      setStatus("Please fill in your name, a valid email, and a message.", false);
      return;
    }

    if (button) button.disabled = true;
    try {
      const res = await fetch(`${api}/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, message, website }),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (res.ok) {
        form.reset();
        setStatus("Message sent — I'll get back to you soon. Thanks!", true);
      } else {
        setStatus(data.error || "Something went wrong. Please try again.", false);
      }
    } catch {
      setStatus("Network error. Please try again.", false);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
