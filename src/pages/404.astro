---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · JavadED">
  <section class="flex flex-col items-center text-center pb-16 pt-16">
    <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight tracking-tight">Page not found</h1>
    <p class="mt-4 text-base sm:text-lg leading-relaxed text-subtle-light">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-ink-light text-bg-light text-sm font-bold leading-normal h-10 px-4 flex items-center hover:bg-accent hover:text-white transition-colors"
    >Back to home</a>
  </section>
</Base>
