---
import { render, getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, status, url } = project.data;

const badgeClasses: Record<string, string> = {
  live: "bg-green-100 text-green-700",
  building: "bg-blue-100 text-blue-700",
  archived: "bg-stone-100 text-stone-600",
};
---

<Base title={`${title} · JavadED`}>
  <section class="pb-16 pt-4 sm:pt-8">
    <a href="/projects" class="inline-flex items-center text-sm font-medium text-subtle-light hover:text-primary transition-colors">
      ← Back to all projects
    </a>

    <div class="mt-6 flex flex-col gap-3">
      <div class="flex items-center gap-4">
        <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight tracking-tight">{title}</h1>
        <span class:list={["inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", badgeClasses[status]]}>
          {status.charAt(0).toUpperCase() + status.slice(1)}
        </span>
      </div>
      {tagline && <p class="text-lg text-subtle-light">{tagline}</p>}
      <div class="rich-text-body">
        <Content />
      </div>

      {url && (
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class="mt-2 inline-flex items-center gap-2 w-fit rounded-lg bg-ink-light text-bg-light px-4 h-10 text-sm font-bold hover:bg-accent hover:text-white transition-colors"
        >
          Visit Project <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      )}
    </div>
  </section>
</Base>
