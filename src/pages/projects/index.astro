---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getOrderedProjects } from "../../lib/content";

const projects = await getOrderedProjects();
---

<Base title="Projects · JavadED">
  <section class="flex flex-col items-center text-center pb-12 pt-4 sm:pt-8">
    <h1 class="font-serif text-5xl sm:text-6xl font-bold leading-tight tracking-tight">Projects</h1>
  </section>

  <div class="w-full flex flex-col">
    {projects.map((project, index) => (
      <div class={index > 0 ? "mt-12 pt-12 border-t border-edge-light" : "mt-8"}>
        <ProjectCard project={project} reverse={index % 2 === 1} />
      </div>
    ))}
  </div>
</Base>
