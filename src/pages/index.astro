---
import Base from "../layouts/Base.astro";
import Subscribe from "../components/Subscribe.astro";
import { getPublishedPosts, formatDate } from "../lib/content";

const posts = await getPublishedPosts(3);
---

<Base>
  <section class="pb-12 sm:pb-20 pt-4 sm:pt-8">
    <div class="flex flex-col gap-6">
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight">
        I'm Javad. I build software and figure things out along the way.
      </h1>
      <p class="text-lg sm:text-xl font-normal leading-relaxed text-subtle-light max-w-xl">
        Most of what I build starts with a problem I have myself.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/projects"
          class="rounded-lg bg-ink-light text-bg-light text-sm font-bold leading-normal tracking-[0.015em] h-10 px-4 flex items-center hover:bg-accent hover:text-white transition-colors"
        >See my projects</a>
        <a
          href="/posts"
          class="rounded-lg border border-edge-light text-sm font-bold leading-normal h-10 px-4 flex items-center hover:border-primary hover:text-primary transition-colors"
        >Read the blog</a>
      </div>
    </div>
  </section>

  <section class="border-t border-edge-light pt-12 pb-20 sm:pt-16">
    <div class="flex flex-col gap-4 sm:gap-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold leading-tight tracking-tight">Writing</h2>

      <div class="mt-4 flex flex-col gap-8">
        {posts.map((post) => (
          <article class="flex flex-col gap-2">
            <p class="text-sm text-subtle-light font-medium">{formatDate(post.data.pubDate)}</p>
            <a href={`/posts/${post.id}`} class="group">
              <h3 class="font-serif text-xl sm:text-2xl font-bold group-hover:text-primary transition-colors">
                {post.data.title}
              </h3>
            </a>
            {post.data.excerpt && (
              <p class="text-base leading-relaxed text-subtle-light">{post.data.excerpt}</p>
            )}
          </article>
        ))}
      </div>

      <a href="/posts" class="mt-6 inline-flex items-center text-sm font-medium hover:text-primary transition-colors">
        View all posts →
      </a>
    </div>
  </section>

  <Subscribe />
</Base>
