---
import Base from "../../layouts/Base.astro";
import Subscribe from "../../components/Subscribe.astro";
import { getPublishedPosts, formatDate } from "../../lib/content";

const posts = await getPublishedPosts();
---

<Base title="Blog · JavadED">
  <section class="pb-16 pt-4 sm:pt-8">
    <div class="flex flex-col gap-12 sm:gap-16">
      {posts.map((post) => (
        <article class="flex flex-col gap-2 border-b border-edge-light pb-12 sm:pb-16 last:border-b-0">
          <p class="text-sm text-subtle-light font-medium">{formatDate(post.data.pubDate)}</p>
          <a href={`/posts/${post.id}`} class="group">
            <h3 class="font-serif text-3xl sm:text-4xl font-bold group-hover:text-primary transition-colors">
              {post.data.title}
            </h3>
            {post.data.excerpt && (
              <p class="mt-4 text-base leading-relaxed text-subtle-light">{post.data.excerpt}</p>
            )}
          </a>
        </article>
      ))}
    </div>

    <Subscribe />
  </section>
</Base>
