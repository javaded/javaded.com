---
const apiBase = import.meta.env.PUBLIC_API_URL ?? "";
---

<div class="mt-16 sm:mt-24 flex flex-col items-center gap-4 text-center">
  <p class="text-lg text-subtle-light">Subscribe to get future posts via email</p>
  <form
    data-api={apiBase}
    class="js-subscribe w-full max-w-md flex flex-col sm:flex-row gap-2 sm:gap-2"
    novalidate
  >
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input
      type="email"
      name="email"
      required
      placeholder="you@example.com"
      aria-label="Email address"
      class="w-full rounded-lg border bg-transparent px-4 py-2.5 text-base font-normal leading-normal placeholder:text-subtle-light border-edge-light focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
    />
    <button
      type="submit"
      class="rounded-lg bg-ink-light text-bg-light text-sm font-bold leading-normal h-11 px-5 flex items-center justify-center hover:bg-accent hover:text-white transition-colors cursor-pointer whitespace-nowrap disabled:opacity-50"
    >Subscribe</button>
  </form>
  <p class="js-subscribe-status text-sm text-subtle-light" role="status" aria-live="polite"></p>
  <p class="text-sm text-subtle-light">Or follow along via <a href="/rss.xml" class="text-primary hover:underline">RSS</a></p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>(".js-subscribe");
  const status = document.querySelector<HTMLElement>(".js-subscribe-status");
  const button = form?.querySelector<HTMLButtonElement>("button");

  function setStatus(message: string, ok: boolean) {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle("text-red-400", !ok);
    status.classList.toggle("text-subtle-light", ok);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const api = form.dataset.api?.replace(/\/$/, "");
    const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
    const website = (form.elements.namedItem("website") as HTMLInputElement).value;

    if (!api) {
      setStatus("Subscriptions are not configured yet.", false);
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus("Please enter a valid email address.", false);
      return;
    }

    if (button) button.disabled = true;
    try {
      const res = await fetch(`${api}/subscribe`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, website }),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (res.ok) {
        form.reset();
        setStatus("You're on the list — thanks for subscribing!", true);
      } else {
        setStatus(data.error || "Something went wrong. Please try again.", false);
      }
    } catch {
      setStatus("Network error. Please try again.", false);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
