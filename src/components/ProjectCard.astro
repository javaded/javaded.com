---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  reverse?: boolean;
}

const { project, reverse = false } = Astro.props;
const { title, tagline, status, url, icon } = project.data;

const badgeClasses: Record<string, string> = {
  live: "bg-green-100 text-green-700",
  building: "bg-blue-100 text-blue-700",
  archived: "bg-stone-100 text-stone-600",
};
---

<div class:list={["flex flex-col items-start gap-6 md:gap-12", reverse ? "md:flex-row-reverse" : "md:flex-row"]}>
  <div class="flex flex-col flex-1 gap-3">
    <div class="flex items-center gap-4">
      <h2 class="font-serif text-2xl font-bold">{title}</h2>
      {tagline && <span class="text-sm text-subtle-light">{tagline}</span>}
      <span class:list={["inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", badgeClasses[status]]}>
        {status.charAt(0).toUpperCase() + status.slice(1)}
      </span>
    </div>
    <p class="text-base font-normal leading-relaxed text-subtle-light">{project.body ? (project.body.trim() || "") : ""}</p>

    {
      url ? (
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2 text-primary text-sm font-medium w-fit hover:underline"
        >
          Visit Project <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      ) : (
        <a href={`/projects/${project.id}`} class="flex items-center gap-2 text-primary text-sm font-medium w-fit hover:underline">
          Learn more
        </a>
      )
    }
  </div>

  <div class="w-full md:w-1/3 mt-4 md:mt-0">
    <div class="w-full aspect-video rounded-lg bg-stone-100 flex items-center justify-center">
      <span class="material-symbols-outlined text-stone-400" style="font-size: 48px;">{icon}</span>
    </div>
  </div>
</div>
