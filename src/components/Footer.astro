---
const year = new Date().getFullYear();
---

<footer class="mt-auto py-10 text-center">
  <div class="flex justify-center gap-6">
    <a
      href="https://x.com/javaded"
      class="text-subtle-light hover:text-primary transition-colors"
      target="_blank"
      rel="noopener"
      aria-label="Twitter"
    >X / Twitter</a>
    <a
      href="https://github.com/javaded"
      class="text-subtle-light hover:text-primary transition-colors"
      target="_blank"
      rel="noopener"
      aria-label="GitHub"
    >GitHub</a>
    <a
      href="https://www.youtube.com/@Javaded"
      class="text-subtle-light hover:text-primary transition-colors"
      target="_blank"
      rel="noopener"
      aria-label="YouTube"
    >YouTube</a>
  </div>
  <p class="mt-6 text-sm text-subtle-light">© {year} Javad Effat Doost. All rights reserved.</p>
</footer>
