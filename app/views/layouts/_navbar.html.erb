<div data-controller="mobile-nav">
  <header class="flex items-center justify-between whitespace-nowrap py-8 sm:py-10">
  <div class="flex items-center gap-3">
    <%= link_to root_path, class: "flex items-center gap-3" do %>
      <span class="size-6 text-ink-light">
        <svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <g clip-path="url(#clip0_6_330)">
            <path clip-rule="evenodd" d="M24 0.757355L47.2426 24L24 47.2426L0.757355 24L24 0.757355ZM21 35.7574V12.2426L9.24264 24L21 35.7574Z" fill="currentColor" fill-rule="evenodd"></path>
          </g>
          <defs>
            <clipPath id="clip0_6_330">
              <rect fill="white" height="48" width="48"></rect>
            </clipPath>
          </defs>
        </svg>
      </span>
      <h2 class="text-xl font-bold tracking-tight">javaded</h2>
    <% end %>
  </div>

  <nav class="hidden sm:flex items-center gap-8">
    <%= nav_link_to "Home", root_path %>
    <%= nav_link_to "Projects", projects_path %>
    <%= nav_link_to "Blog", posts_path %>
    <%= nav_link_to "About", about_path %>
    <% if authenticated? %>
      <%= link_to "Admin", admin_root_path, class: "text-sm font-medium leading-normal text-subtle-light hover:text-primary transition-colors" %>
    <% end %>
    <button type="button" data-controller="theme" data-action="theme#toggle" aria-label="Toggle dark mode"
          class="flex items-center text-subtle-light hover:text-primary transition-colors">
      <span data-theme-target="icon" class="material-symbols-outlined leading-none">light_mode</span>
    </button>
    <%= link_to "Get in touch", contact_path,
          class: "flex min-w-[84px] cursor-pointer items-center justify-center rounded-lg h-10 px-4 bg-ink-light text-bg-light text-sm font-bold leading-normal tracking-[0.015em] hover:bg-accent hover:text-white transition-colors" %>
  </nav>

  <div class="sm:hidden flex items-center gap-2">
    <button type="button" data-controller="theme" data-action="theme#toggle" aria-label="Toggle dark mode"
          class="flex items-center p-2 -mr-2 text-subtle-light hover:text-primary transition-colors">
      <span data-theme-target="icon" class="material-symbols-outlined leading-none">light_mode</span>
    </button>
    <button type="button" data-action="mobile-nav#toggle" aria-label="Open menu" aria-expanded="false"
          class="flex items-center p-2 -mr-2">
      <span data-mobile-nav-target="icon" class="material-symbols-outlined text-ink-light leading-none">menu</span>
    </button>
  </div>
  </header>

  <div data-mobile-nav-target="menu" class="hidden sm:hidden flex-col gap-1 pb-6">
    <div class="py-2">
      <%= nav_link_to "Home", root_path %>
      <%= nav_link_to "Projects", projects_path %>
      <%= nav_link_to "Blog", posts_path %>
      <%= nav_link_to "About", about_path %>
      <% if authenticated? %>
        <%= link_to "Admin", admin_root_path, class: "block py-2 text-sm font-medium leading-normal text-subtle-light hover:text-primary transition-colors" %>
      <% end %>
      <%= link_to "Get in touch", contact_path,
            class: "block py-2 text-sm font-bold leading-normal text-primary" %>
    </div>
  </div>
</div>
