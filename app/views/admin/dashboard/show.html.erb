<section class="flex flex-col gap-12">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold tracking-tight">Dashboard</h1>
    <div class="flex gap-3">
      <%= link_to "New post", new_admin_post_path, class: "inline-flex items-center rounded-lg bg-ink-light text-bg-light px-4 h-10 text-sm font-bold hover:bg-accent hover:text-white transition-colors" %>
      <%= link_to "New project", new_admin_project_path, class: "inline-flex items-center rounded-lg border border-edge-light px-4 h-10 text-sm font-bold hover:border-primary transition-colors" %>
    </div>
  </div>

  <div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold">Recent posts</h2>
      <%= link_to "All posts", admin_posts_path, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
    </div>
    <ul class="flex flex-col divide-y divide-edge-light border-y border-edge-light">
      <% @posts.each do |post| %>
        <li class="flex items-center justify-between py-3">
          <div class="flex flex-col">
            <span class="font-medium"><%= post.title.presence || "Untitled" %></span>
            <span class="text-xs text-subtle-light">
              <%= post.published? ? "Published #{l post.published_at, format: :long}" : "Draft" %>
            </span>
          </div>
          <%= link_to "Edit", edit_admin_post_path(post), class: "text-sm font-medium text-primary hover:underline" %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold">Projects</h2>
      <%= link_to "All projects", admin_projects_path, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
    </div>
    <ul class="flex flex-col divide-y divide-edge-light border-y border-edge-light">
      <% @projects.each do |project| %>
        <li class="flex items-center justify-between py-3">
          <div class="flex items-center gap-3">
            <span class="font-medium"><%= project.title.presence || "Untitled" %></span>
            <% if project.featured? %>
              <span class="rounded-full bg-accent/10 text-accent px-2 py-0.5 text-xs font-medium">Featured</span>
            <% end %>
          </div>
          <%= link_to "Edit", edit_admin_project_path(project), class: "text-sm font-medium text-primary hover:underline" %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
