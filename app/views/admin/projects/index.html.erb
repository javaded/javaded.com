<section class="flex flex-col gap-8">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
    <%= link_to "New project", new_admin_project_path, class: "inline-flex items-center rounded-lg bg-ink-light text-bg-light px-4 h-10 text-sm font-bold hover:bg-accent hover:text-white transition-colors" %>
  </div>

  <ul class="flex flex-col divide-y divide-edge-light border-y border-edge-light">
    <% @projects.each do |project| %>
      <li class="flex items-center justify-between py-4 gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <span class="font-medium truncate"><%= project.title.presence || "Untitled" %></span>
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap <%= project.status_badge_classes.join(" ") %>">
            <%= project.status.humanize %>
          </span>
          <% if project.featured? %>
            <span class="rounded-full bg-accent/10 text-accent px-2 py-0.5 text-xs font-medium whitespace-nowrap">Featured</span>
          <% end %>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <%= link_to "View", project, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
          <%= link_to "Edit", edit_admin_project_path(project), class: "text-sm font-medium text-primary hover:underline" %>
          <%= button_to "Delete", admin_project_path(project), method: :delete, data: { turbo_confirm: "Delete this project?" }, class: "text-sm font-medium text-red-600 hover:underline cursor-pointer" %>
        </div>
      </li>
    <% end %>
  </ul>
</section>
