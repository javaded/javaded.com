<%= form_with model: [ :admin, project ], data: { turbo: false } do |form| %>
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <%= form.label :title, class: admin_label_class %>
      <%= form.text_field :title, placeholder: "Untitled project", class: "#{admin_input_class} text-base" %>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :tagline, class: admin_label_class %>
      <%= form.text_field :tagline, placeholder: "One-line summary.", class: admin_input_class %>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :url, "URL", class: admin_label_class %>
      <%= form.url_field :url, placeholder: "https://", class: admin_input_class %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="flex flex-col gap-2">
        <%= form.label :slug, class: admin_label_class %>
        <%= form.text_field :slug, class: admin_input_class %>
        <p class="text-xs text-subtle-light">Auto-generated from title if left blank.</p>
      </div>
      <div class="flex flex-col gap-2">
        <%= form.label :status, class: admin_label_class %>
        <%= form.select :status, Project.statuses.keys.map { |s| [ s.humanize, s ] }, {}, class: admin_input_class %>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :description, class: admin_label_class %>
      <div class="admin-editor">
        <%= form.rich_text_area :description %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= form.check_box :featured, class: "size-4 rounded border-edge-light text-primary focus:ring-primary" %>
      <%= form.label :featured, "Featured on home page", class: "text-sm font-medium" %>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= form.submit "Save project", class: "inline-flex items-center rounded-lg bg-ink-light text-bg-light px-4 h-10 text-sm font-bold hover:bg-accent hover:text-white transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_projects_path, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
    </div>
  </div>
<% end %>
