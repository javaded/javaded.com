<section class="flex flex-col gap-8">
  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">Edit project</h1>
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap <%= @project.status_badge_classes.join(" ") %>">
        <%= @project.status.humanize %>
      </span>
      <% if @project.featured? %>
        <span class="rounded-full bg-accent/10 text-accent px-2 py-0.5 text-xs font-medium whitespace-nowrap">Featured</span>
      <% end %>
    </div>
    <div class="flex items-center gap-4">
      <%= link_to "View on site →", @project, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
      <%= button_to "Delete", admin_project_path(@project), method: :delete, data: { turbo_confirm: "Delete this project? This cannot be undone." }, class: "text-sm font-medium text-red-600 hover:underline cursor-pointer" %>
    </div>
  </div>
  <%= render "form", project: @project %>
</section>
