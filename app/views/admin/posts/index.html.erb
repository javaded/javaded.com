<section class="flex flex-col gap-8">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold tracking-tight">Posts</h1>
    <%= link_to "New post", new_admin_post_path, class: "inline-flex items-center rounded-lg bg-ink-light text-bg-light px-4 h-10 text-sm font-bold hover:bg-accent hover:text-white transition-colors" %>
  </div>

  <ul class="flex flex-col divide-y divide-edge-light border-y border-edge-light">
    <% @posts.each do |post| %>
      <li class="flex items-center justify-between py-4 gap-4">
        <div class="flex flex-col min-w-0">
          <div class="flex items-center gap-2">
            <span class="font-medium truncate"><%= post.title.presence || "Untitled" %></span>
            <% if post.published? %>
              <span class="rounded-full bg-green-100 text-green-700 px-2 py-0.5 text-xs font-medium whitespace-nowrap">Published</span>
            <% else %>
              <span class="rounded-full bg-stone-100 text-stone-600 px-2 py-0.5 text-xs font-medium whitespace-nowrap">Draft</span>
            <% end %>
          </div>
          <span class="text-xs text-subtle-light mt-1"><%= post.slug %></span>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <% if post.published? %>
            <%= link_to "View", post, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
          <% end %>
          <%= link_to "Edit", edit_admin_post_path(post), class: "text-sm font-medium text-primary hover:underline" %>
          <%= button_to "Delete", admin_post_path(post), method: :delete, data: { turbo_confirm: "Delete this post?" }, class: "text-sm font-medium text-red-600 hover:underline cursor-pointer" %>
        </div>
      </li>
    <% end %>
  </ul>
</section>
