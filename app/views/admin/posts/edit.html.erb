<section class="flex flex-col gap-8">
  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">Edit post</h1>
      <% if @post.published? %>
        <span class="rounded-full bg-green-100 text-green-700 px-2 py-0.5 text-xs font-medium whitespace-nowrap">Published</span>
      <% else %>
        <span class="rounded-full bg-stone-100 text-stone-600 px-2 py-0.5 text-xs font-medium whitespace-nowrap">Draft</span>
      <% end %>
    </div>
    <div class="flex items-center gap-4">
      <% if @post.published? %>
        <%= link_to "View on site →", @post, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
      <% end %>
      <%= button_to "Delete", admin_post_path(@post), method: :delete, data: { turbo_confirm: "Delete this post? This cannot be undone." }, class: "text-sm font-medium text-red-600 hover:underline cursor-pointer" %>
    </div>
  </div>
  <%= render "form", post: @post %>
</section>
