<%= form_with model: [ :admin, post ], data: { turbo: false } do |form| %>
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <%= form.label :title, class: admin_label_class %>
      <%= form.text_field :title, placeholder: "Untitled post", class: "#{admin_input_class} text-base" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="flex flex-col gap-2">
        <%= form.label :slug, class: admin_label_class %>
        <%= form.text_field :slug, class: admin_input_class %>
        <p class="text-xs text-subtle-light">Auto-generated from title if left blank.</p>
      </div>
      <div class="flex flex-col gap-2">
        <%= form.label :published_at, "Publish at", class: admin_label_class %>
        <%= form.datetime_local_field :published_at, class: admin_input_class %>
        <p class="text-xs text-subtle-light">Leave blank to keep as a draft.</p>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :excerpt, class: admin_label_class %>
      <%= form.text_area :excerpt, rows: 2, placeholder: "A short summary shown on listings and the post page.", class: admin_input_class %>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :body, class: admin_label_class %>
      <div class="admin-editor">
        <%= form.rich_text_area :body %>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :reading_time, "Reading time (minutes)", class: admin_label_class %>
      <%= form.number_field :reading_time, min: 1, class: "#{admin_input_class} max-w-xs" %>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= form.submit "Save post", class: "inline-flex items-center rounded-lg bg-ink-light text-bg-light px-4 h-10 text-sm font-bold hover:bg-accent hover:text-white transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_posts_path, class: "text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>
    </div>
  </div>
<% end %>
