<div class="flex flex-col <%= local_assigns[:reverse] ? "md:flex-row-reverse" : "md:flex-row" %> items-start gap-6 md:gap-12">
  <div class="flex flex-col flex-1 gap-3">
    <div class="flex items-center gap-4">
      <h2 class="font-serif text-2xl font-bold"><%= project.title %></h2>
      <% if project.tagline.present? %>
        <span class="text-sm text-subtle-light"><%= project.tagline %></span>
      <% end %>
      <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium <%= project.status_badge_classes.join(" ") %>">
        <%= project.status.humanize %>
      </span>
    </div>
    <p class="text-base font-normal leading-relaxed text-subtle-light"><%= project.description %></p>

    <% if project.url.present? %>
      <%= link_to project.url, target: "_blank", rel: "noopener",
            class: "flex items-center gap-2 text-primary text-sm font-medium w-fit hover:underline" do %>
        Visit Project <span class="material-symbols-outlined text-base">arrow_forward</span>
      <% end %>
    <% else %>
      <%= link_to "Learn more", project,
            class: "flex items-center gap-2 text-primary text-sm font-medium w-fit hover:underline" %>
    <% end %>
  </div>

  <div class="w-full md:w-1/3 mt-4 md:mt-0">
    <div class="w-full aspect-video rounded-lg bg-stone-100 flex items-center justify-center">
      <span class="material-symbols-outlined text-stone-400" style="font-size: 48px;"><%= project_icon(project) %></span>
    </div>
  </div>
</div>
