<section class="flex flex-col items-center text-center pb-12 pt-4 sm:pt-8">
  <h1 class="font-serif text-5xl sm:text-6xl font-bold leading-tight tracking-tight">Projects</h1>
  <p class="mt-4 max-w-lg text-lg sm:text-xl font-normal leading-relaxed text-subtle-light">
    I build tools that merge creativity, sport, and code.
  </p>
</section>

<div class="w-full flex flex-col">
  <% @projects.each_with_index do |project, index| %>
    <div class="<%= index > 0 ? "mt-12 pt-12 border-t border-edge-light" : "mt-8" %>">
      <%= render partial: "projects/project", locals: { project: project, reverse: index.odd? } %>
    </div>
  <% end %>
</div>
