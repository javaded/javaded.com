<section class="pb-16 pt-4 sm:pt-8">
  <%= link_to "← Back to all projects", projects_path,
        class: "inline-flex items-center text-sm font-medium text-subtle-light hover:text-primary transition-colors" %>

  <div class="mt-6 flex flex-col gap-3">
    <div class="flex items-center gap-4">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight tracking-tight"><%= @project.title %></h1>
      <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium <%= @project.status_badge_classes.join(" ") %>">
        <%= @project.status.humanize %>
      </span>
    </div>
    <% if @project.tagline.present? %>
      <p class="text-lg text-subtle-light"><%= @project.tagline %></p>
    <% end %>
    <p class="text-lg leading-relaxed text-subtle-light"><%= @project.description %></p>

    <% if @project.url.present? %>
      <%= link_to @project.url, target: "_blank", rel: "noopener",
            class: "mt-2 inline-flex items-center gap-2 w-fit rounded-lg bg-ink-light text-bg-light px-4 h-10 text-sm font-bold hover:bg-accent hover:text-white transition-colors" do %>
        Visit Project <span class="material-symbols-outlined text-base">arrow_forward</span>
      <% end %>
    <% end %>
  </div>
</section>
