<section class="pb-16 pt-4 sm:pt-8">
  <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight tracking-tight pb-4"><%= @post.title %></h1>

  <p class="text-sm text-subtle-light font-normal leading-normal pb-12 pt-1">
    <% if @post.published_at %>
      Published on <%= @post.published_at.strftime("%B %-d, %Y") %>
    <% else %>
      Draft
    <% end %>
    <% if @post.reading_time.present? %>
      &bull; <%= @post.reading_time %> min read
    <% end %>
  </p>

  <% if @post.excerpt.present? %>
    <p class="text-xl font-normal leading-relaxed text-subtle-light pb-8">
      <%= @post.excerpt %>
    </p>
  <% end %>

  <article class="rich-text-body">
    <%= @post.body %>
  </article>

  <%= render "subscribers/subscribe" %>

  <footer class="mt-16 pt-8 border-t border-edge-light flex flex-col sm:flex-row items-start sm:items-center sm:justify-between gap-4">
    <%= link_to posts_path,
          class: "inline-flex items-center text-subtle-light hover:text-primary transition-colors" do %>
      <span class="material-symbols-outlined mr-2">arrow_back</span>
      Back to all posts
    <% end %>
    <%= link_to "Follow me on X for shorter thoughts", "https://x.com/javaded", target: "_blank", rel: "noopener",
          class: "inline-flex items-center text-subtle-light hover:text-primary transition-colors" %>
  </footer>
</section>
